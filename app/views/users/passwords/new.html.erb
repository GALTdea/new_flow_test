<% content_for :title, "#{application_name} | Reset password" %>

<section class="content-page" aria-labelledby="reset-password-title">
  <%= render "shared/page_header",
        id: "reset-password-title",
        eyebrow: "Account",
        title: "Reset your password",
        description: "Enter the email for your account. If it matches an account, we will send reset instructions." %>

  <%= form_with model: resource, as: resource_name, url: password_path(resource_name), method: :post, class: "form-panel" do |form| %>
    <%= render "shared/form_errors", object: resource %>

    <div class="form-field">
      <%= form.label :email %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, **field_accessibility(form, :email) %>
      <%= render "shared/field_error", form: form, attribute: :email %>
    </div>

    <div class="form-actions">
      <%= form.submit "Send reset instructions" %>
    </div>
  <% end %>

  <%= render "users/shared/links" %>
</section>
