<% content_for :title, "#{application_name} | Create account" %>

<section class="content-page" aria-labelledby="sign-up-title">
  <%= render "shared/page_header",
        id: "sign-up-title",
        eyebrow: "Account",
        title: "Create an account",
        description: "An account is for signing back in later. It stores email and password only." %>

  <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), class: "form-panel", data: { turbo: false } do |form| %>
    <%= render "shared/form_errors", object: resource %>

    <div class="form-field">
      <%= form.label :email %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, **field_accessibility(form, :email) %>
      <%= render "shared/field_error", form: form, attribute: :email %>
    </div>

    <div class="form-field">
      <%= form.label :password %>
      <% if @minimum_password_length %>
        <p id="<%= form.field_id(:password, :hint) %>" class="field-help"><%= @minimum_password_length %> characters minimum.</p>
      <% end %>
      <%= form.password_field :password,
            autocomplete: "new-password",
            required: true,
            **field_accessibility(form, :password, describedby: (@minimum_password_length ? form.field_id(:password, :hint) : nil)) %>
      <%= render "shared/field_error", form: form, attribute: :password %>
    </div>

    <div class="form-field">
      <%= form.label :password_confirmation %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true, **field_accessibility(form, :password_confirmation) %>
      <%= render "shared/field_error", form: form, attribute: :password_confirmation %>
    </div>

    <div class="form-actions">
      <%= form.submit "Create account" %>
    </div>
  <% end %>

  <%= render "users/shared/links" %>
</section>
